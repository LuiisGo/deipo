# Controlled Sprint 01 acceptance uses production in both Netlify contexts.
# Local storefront regression may explicitly select preview.
NEXT_PUBLIC_SITE_MODE=production
# Optional absolute HTTPS origin for canonical/OG metadata; not used for auth.
NEXT_PUBLIC_SITE_URL=
# Required: configure for Builds and Functions in the existing Netlify site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sprint 03: server-only, Sandbox acceptance only. Never use NEXT_PUBLIC_* for these.
SUPABASE_SECRET_KEY=
RECURRENTE_SECRET_KEY=
RECURRENTE_MODE=sandbox
RECURRENTE_SANDBOX_ID=
# Add after registering the authorized Deploy Preview endpoint; not needed to build.
RECURRENTE_WEBHOOK_SECRET=
# Exact HTTPS origin for authorized Deploy Preview only, Functions/runtime scope.
# Leave unset in Production. Do not derive authorization from build-only metadata.
PAYMENT_ALLOWED_ORIGIN=
# Sprint 04B: server-only fixed HTTPS origin for staff invitation redirects.
# Requires SUPABASE_SECRET_KEY plus /ops/accept in the Auth redirect allowlist.
# Configuring staff does not authorize Recurrente checkout or Production ordering.
STAFF_INVITE_ORIGIN=

# Sprint04C manual sales; public business WhatsApp, international digits without +.
NEXT_PUBLIC_SALES_WHATSAPP_NUMBER=
# Exact HTTPS public origin for assisted links and tracker QR. Not a payment allowlist.
CUSTOMER_COMMERCE_ORIGIN=
# Server-only 32 random bytes encoded as 64 lowercase hex. Never NEXT_PUBLIC.
CUSTOMER_ACCESS_ENCRYPTION_KEY=
